<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="mail_template_lead_ack" model="mail.template">
      <field name="name">[CRM] Acuse de recibo Lead</field>
      <field name="model_id" ref="crm.model_crm_lead"/>
      <field name="subject">¡Gracias por contactarnos, ${object.contact_name or '!'}</field>
      <field name="email_from">${(object.company_id.email or 'odoo@globalsnopek.es') | safe}</field>
      <field name="email_to">${object.email_from or ''}</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html"><![CDATA[
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:1.5;">
          <p>Hola ${object.contact_name or 'allí'},</p>
          <p>¡Gracias por escribirnos! Tu solicitud ha sido recibida por nuestro equipo.
             Un asesor se pondrá en contacto contigo en un máximo de <b>12 horas</b>.</p>

          <p><b>¿Quieres hablar ahora?</b></p>
          <p>
            <a href="https://wa.me/xxxxxxxxxxx" style="background:#25D366;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none;">
              Chatear por WhatsApp
            </a>
            &nbsp;&nbsp;
            <a href="https://gestion.acdesweb.org" style="background:#0d6efd;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none;">
              Visitar nuestro sitio
            </a>
          </p>

          <p style="color:#6c757d;">
            Referencia: ${object.display_name}
          </p>

          <p>Saludos,<br/>Equipo de Ventas</p>
        </div>
      ]]></field>
    </record>
  </data>
</odoo>
